{
  "name": "fablab-stock",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi du stock de matières du fablab (filament et plaques)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "verifier": "wrangler types && tsc --noEmit",
    "types": "wrangler types",
    "polices": "node scripts/copier-polices.mjs",
    "migrer:local": "wrangler d1 migrations apply DB --local",
    "migrer:prod": "wrangler d1 migrations apply DB --remote",
    "deployer": "wrangler deploy",
    "demo:local": "wrangler d1 execute DB --local --file scripts/donnees-demo.sql",
    "icones": "node scripts/generer-icones.mjs",
    "dev:reseau": "wrangler dev --ip 0.0.0.0"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
